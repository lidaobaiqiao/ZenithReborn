<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><BuildMod>false</BuildMod><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <!-- tModLoader 安装路径可按机器覆盖：优先级为 环境变量 ZENITH_TML_ROOT > 仓库根 local.props 的 TmlRoot > 默认值。 -->
  <Import Project="$(MSBuildThisFileDirectory)../../local.props" Condition="Exists('$(MSBuildThisFileDirectory)../../local.props')" />
  <PropertyGroup>
    <TmlRoot Condition="'$(ZENITH_TML_ROOT)' != ''">$(ZENITH_TML_ROOT)</TmlRoot>
    <TmlRoot Condition="'$(TmlRoot)' == ''">E:/SteamLibrary/steamapps/common/tModLoader</TmlRoot>
  </PropertyGroup>
  <Import Project="$(TmlRoot)/tMLMod.targets" />
  <ItemGroup><Reference Include="ZenithReborn"><HintPath>../../ZenithReborn/bin/Release/net8.0/ZenithReborn.dll</HintPath><Private>false</Private></Reference></ItemGroup>
</Project>
